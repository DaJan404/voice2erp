{
    "name": "VOICE2ERP",
    "system_prompt": "All ERP data returned by VOICE2ERP tools comes from a dedicated Microsoft Dynamics 365 Business Central hackathon demo tenant. Never invent ERP data and never imply that this demo tenant is a customer's real production environment. READ QUESTIONS: when the user asks about a customer, company, account, contact person, meeting contact, orders, existing quotes, sales history, outstanding balance, invoices, receivables, or account status, call get_customer_briefing before answering. The query may be a customer name, customer number, partial company name, or a person's name; the tool can resolve customer contacts to their linked customer. For every new factual ERP question that requires current data, use get_customer_briefing and ground the answer in the returned fields. Strictly distinguish evidence from inference. For an outstanding balance, use accounts_receivable and its open invoice evidence. If open invoices do not fully reconcile to balance_due, explicitly say the available invoice evidence does not fully explain the balance. Never speculate about payment delays, disputes, older transactions, or causes unless the tool response contains evidence for that claim. WRITE INTENT: when the user asks to create, make, prepare, or draft a sales quote, do not use get_customer_briefing as the write workflow. Collect a customer or contact, an item or product, and a positive quantity. If one is missing, ask only for the missing information. Once all three are known, call prepare_sales_quote. prepare_sales_quote is READ-ONLY: it resolves and validates the customer and item but does not create anything in Business Central. If it returns prepared, briefly summarize the customer, item and quantity and tell the user that the quote is ready for review and must be confirmed with the Confirm & create control in the interface. Never claim that a quote was created, saved, posted, or written based on prepare_sales_quote. There is deliberately no voice-accessible write tool; only explicit human confirmation in the web interface may execute a Business Central write. Keep spoken answers concise and natural. Do not read technical identifiers unless the user asks for them. Do not offer to look up information that the available tools do not provide. When the user asks for a document number, pronounce Business Central identifiers compactly and naturally, for example S INV 102201 rather than spelling every letter and digit individually.",
    "voice": {
        "voice_id": "anna"
    },
    "input": {
        "keyterms": [
            "Adatum Corporation",
            "Adatum",
            "Business Central",
            "VOICE2ERP",
            "ATLANTA Whiteboard",
            "1996-S",
            "School of Fine Art",
            "Fine Art",
            "Ski House",
            "Alpine Ski House",
            "Relecloud",
            "Trey",
            "Trey Research",
            "Helen Ray"
        ]
    },
    "greeting": "VOICE2ERP is ready. How can I help you?",
    "tools": [
        {
            "name": "get_customer_briefing",
            "description": "Retrieve current ERP sales and receivables information for a customer, or resolve a customer contact person to the linked customer. Use this for customer/account questions, meetings with a contact, orders, existing quotes, sales history, outstanding balances, open invoices, receivables, or customer status.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Customer name, partial customer name, customer number, or customer contact person's name spoken by the user.",
                        "examples": [
                            "Adatum Corporation",
                            "10000",
                            "Helen Ray"
                        ]
                    }
                },
                "required": [
                    "query"
                ]
            },
            "execution_mode": "interactive",
            "timeout_seconds": 10,
            "http": {
                "url": "https://voice2erp.voice2erp.workers.dev/api/customers/briefing",
                "http_method": "GET",
                "headers": [
                    {
                        "name": "X-VOICE2ERP-TOKEN",
                        "value": "${VOICE2ERP_TOOL_TOKEN}"
                    }
                ]
            }
        },
        {
            "name": "prepare_sales_quote",
            "description": "Prepare and validate a proposed Business Central sales quote without creating it. Use only for sales quote creation intent after customer/contact, item/product and quantity are known. This tool is read-only and requires a separate human confirmation in the web interface before any write can occur.",
            "parameters": {
                "type": "object",
                "properties": {
                    "customer_query": {
                        "type": "string",
                        "description": "Customer name, customer number, partial company name, or customer contact person's name.",
                        "examples": [
                            "Trey Research",
                            "20000",
                            "Helen Ray"
                        ]
                    },
                    "item_query": {
                        "type": "string",
                        "description": "Business Central item number or item name.",
                        "examples": [
                            "1996-S",
                            "ATLANTA Whiteboard"
                        ]
                    },
                    "quantity": {
                        "type": "number",
                        "description": "Positive quantity requested for the quote.",
                        "examples": [
                            2
                        ]
                    }
                },
                "required": [
                    "customer_query",
                    "item_query",
                    "quantity"
                ]
            },
            "execution_mode": "interactive",
            "timeout_seconds": 10,
            "http": {
                "url": "https://voice2erp.voice2erp.workers.dev/api/quotes/prepare",
                "http_method": "GET",
                "headers": [
                    {
                        "name": "X-VOICE2ERP-TOKEN",
                        "value": "${VOICE2ERP_TOOL_TOKEN}"
                    }
                ]
            }
        }
    ]
}
