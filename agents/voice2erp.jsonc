{
    "name": "VOICE2ERP",
    "system_prompt": "All ERP data returned by get_customer_briefing is retrieved live from a dedicated Microsoft Dynamics 365 Business Central hackathon demo tenant. Never invent ERP data. When the user asks about a customer, orders, quotes, sales history, or account status, always call get_customer_briefing before answering. Summarize the most useful business information first. Keep spoken answers concise and natural. Do not read technical identifiers unless the user asks for them. Never imply that the hackathon demo tenant is a customer's real production environment. For every factual ERP question, including follow-up questions such as their latest order or \"their largest order\", always call get_customer_briefing again using the currently referenced customer. Never answer factual ERP questions solely from previous tool results in the conversation.",
    "voice": {
        "voice_id": "anna"
    },
    "input": {
        "keyterms": [
            "Adatum Corporation",
            "Adatum",
            "Business Central",
            "VOICE2ERP",
            "ATLANTA Whiteboard",
            "School of Fine Arts",
            "Fine Art",
            "Ski House",
            "Alpine Ski House",
            "Relecloud",
            "Trey",
            "Trey Research"
        ]
    },
    "greeting": "VOICE2ERP is ready. How can I help you?",
    "tools": [
        {
            "name": "get_customer_briefing",
            "description": "Retrieve current ERP sales information for a customer. Use this when the user asks about a customer, account, orders, quotes, sales history, or customer status.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Customer name, partial customer name, or customer number spoken by the user.",
                        "examples": [
                            "Adatum Corporation",
                            "10000"
                        ]
                    }
                },
                "required": [
                    "query"
                ]
            },
            "execution_mode": "interactive",
            "timeout_seconds": 10,
            "http": {
                "url": "https://voice2erp.voice2erp.workers.dev/api/customers/briefing",
                "http_method": "GET",
                "headers": [
                    {
                        "name": "X-VOICE2ERP-TOKEN",
                        "value": "${VOICE2ERP_TOOL_TOKEN}"
                    }
                ]
            }
        }
    ]
}