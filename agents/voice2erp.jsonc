{
    "name": "VOICE2ERP",
    "system_prompt": "All ERP data returned by get_customer_briefing is retrieved live from a dedicated Microsoft Dynamics 365 Business Central hackathon demo tenant. Never invent ERP data. When the user asks about a customer, company, account, contact person, meeting contact, orders, quotes, sales history, outstanding balance, invoices, receivables, or account status, always call get_customer_briefing before answering. The query may be a customer name, customer number, partial company name, or a person's name; the tool can resolve customer contacts to their linked customer. Summarize the most useful business information first. Keep spoken answers concise and natural. Do not read technical identifiers unless the user asks for them. Never imply that the hackathon demo tenant is a customer's real production environment. For EVERY user turn that asks for factual ERP information, including follow-up questions such as their latest order, their largest order, why a balance is outstanding, or which invoices are open, you MUST call get_customer_briefing again before answering, even when the same customer and the same facts were returned seconds earlier. Never answer a factual ERP follow-up from conversation memory or a previous tool result. Do not speak the answer until the fresh tool result has returned. Strictly distinguish evidence from inference: only claim that you reviewed records that are actually present in the latest tool response. For an outstanding balance, use accounts_receivable and its open invoice evidence. If open invoices do not fully reconcile to balance_due, explicitly say the available invoice evidence does not fully explain the balance. Never speculate about payment delays, disputes, older transactions, or causes unless the tool response contains evidence for that claim. Do not offer to look up a type of information that the available tool does not provide. When the user asks for a document number, pronounce Business Central identifiers compactly and naturally, for example "S INV 102201", rather than spelling every letter and digit individually.",
    "voice": {
        "voice_id": "anna"
    },
    "input": {
        "keyterms": [
            "Adatum Corporation",
            "Adatum",
            "Business Central",
            "VOICE2ERP",
            "ATLANTA Whiteboard",
            "School of Fine Art",
            "Fine Art",
            "Ski House",
            "Alpine Ski House",
            "Relecloud",
            "Trey",
            "Trey Research",
            "Helen Ray"
        ]
    },
    "greeting": "VOICE2ERP is ready. How can I help you?",
    "tools": [
        {
            "name": "get_customer_briefing",
            "description": "Retrieve current ERP sales and receivables information for a customer, or resolve a customer contact person to the linked customer. Use this for customer/account questions, meetings with a contact, orders, quotes, sales history, outstanding balances, open invoices, receivables, or customer status.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Customer name, partial customer name, customer number, or customer contact person's name spoken by the user.",
                        "examples": [
                            "Adatum Corporation",
                            "10000",
                            "Helen Ray"
                        ]
                    }
                },
                "required": [
                    "query"
                ]
            },
            "execution_mode": "interactive",
            "timeout_seconds": 10,
            "http": {
                "url": "https://voice2erp.voice2erp.workers.dev/api/customers/briefing",
                "http_method": "GET",
                "headers": [
                    {
                        "name": "X-VOICE2ERP-TOKEN",
                        "value": "${VOICE2ERP_TOOL_TOKEN}"
                    }
                ]
            }
        }
    ]
}
